{
  "name": "bvdputte/bettersearch",
  "description": "A search plugin for Kirby that searches for full word combinations rather than just individual words.",
  "license": "MIT",
  "homepage": "https://github.com/bvdputte/kirby-bettersearch/",
  "type": "kirby-plugin",
  "version": "6.0.0",
  "authors": [
    {
      "name": "Bart Vandeputte",
      "email": "mail@bartvandeputte.be"
    }
  ],
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby6",
    "kirby-plugin",
    "kirby6-plugin",
    "search"
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/composer-installer": "^1.2"
  },
  "config": {
    "optimize-autoloader": true
  },
  "extra": {
    "kirby": {
      "compatible": "^6.0"
    },
    "installer-name": "kirby-bettersearch"
  }
}
